{
  "pluginAlias": "Hyundai",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "credentials": {
        "type": "object",
        "properties": {
          "username": {
            "title": "Username",
            "type": "string",
            "required": true
          },
          "password": {
            "title": "Password",
            "type": "string",
            "required": true
          },
          "region": {
            "title": "Region",
            "type": "string",
            "required": true,
            "placeholder": "US",
            "oneOf": [
              {
                "title": "United States",
                "enum": [
                  "US"
                ]
              },
              {
                "title": "Canada",
                "enum": [
                  "CA"
                ]
              },
              {
                "title": "Europe",
                "enum": [
                  "EU"
                ]
              }
            ]
          },
          "brand": {
            "title": "Brand",
            "type": "string",
            "required": true,
            "default": "hyundai",
            "oneOf": [
              {
                "title": "Hyundai",
                "enum": [
                  "hyundai"
                ]
              },
              {
                "title": "Kia",
                "enum": [
                  "kia"
                ]
              }
            ]
          },
          "pin": {
            "title": "Pin",
            "type": "string",
            "placeholder": "1234",
            "required": true
          }
        }
      },
      "vehicles": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "vin": {
              "title": "VIN Number",
              "type": "string",
              "required": true
            },
            "maxRange": {
              "type": "number",
              "title": "Maximum Range (mi/km)",
              "required": false
            }
          }
        }
      },
      "remoteStart": {
        "type": "object",
        "properties": {
          "airCtrl": {
            "type": "boolean",
            "title": "Turn on A/C",
            "required": false,
            "default": false
          },
          "heating1": {
            "type": "boolean",
            "title": "Turn on Heat",
            "required": false,
            "default": false
          },
          "defrost": {
            "type": "boolean",
            "title": "Defrost",
            "required": false,
            "default": false
          },
          "airTempvalue": {
            "type": "number",
            "title": "Desired temperature",
            "required": false,
            "placeholder": 72
          },
          "igniOnDuration": {
            "type": "number",
            "title": "How long (minutes)",
            "required": true,
            "default": 15
          }
        }
      },
      "statusInterval": {
        "title": "Status Refresh Interval (minutes)",
        "type": "number",
        "required": false,
        "default": 15,
        "minimum": 5,
        "description": "How often to read Hyundai's cached vehicle status. This does not contact the car, so it uses none of its battery. Lower values keep HomeKit closer to the Bluelink app. Minimum 5."
      },
      "forceRefreshInterval": {
        "title": "Forced Live Refresh Interval (minutes)",
        "type": "number",
        "required": false,
        "default": 0,
        "minimum": 0,
        "description": "How often to wake the vehicle for a live reading. This DOES use the car's 12V battery and counts against Hyundai's daily limits. 0 disables it (recommended) - the car reports in on its own when anything happens to it. Minimum 60 when enabled."
      },
      "showRangeSensor": {
        "title": "Show Range as a Sensor Tile",
        "type": "boolean",
        "required": false,
        "default": false,
        "description": "Publish estimated range as a percentage of Maximum Range on its own tile. HomeKit has no characteristic for distance, so this uses a humidity sensor - the tile reads as a percentage (e.g. 43%) rather than miles. Without it, range is only visible as the battery level on the accessory's settings page."
      }
    }
  }
}
