{
  "private": false,
  "displayName": "Homebridge Hyundai BlueLink",
  "name": "homebridge-bluelink-3-0",
  "version": "2.5.2",
  "description": "Integrates with remote functionality for Hyundai cars.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/cnpittman/homebridge-bluelink-3.0.git"
  },
  "bugs": {
    "url": "https://github.com/cnpittman/homebridge-bluelink-3.0/issues"
  },
  "engines": {
    "node": ">=20.18.0",
    "homebridge": "^1.6.0 || ^2.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint src/**.ts --max-warnings=0",
    "watch": "npm run build && npm link && nodemon 2>&1 | tee /tmp/homebridge.log",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  },
  "keywords": [
    "homebridge-plugin"
  ],
  "dependencies": {
    "bluelinky": "^7.6.2"
  },
  "devDependencies": {
    "@spotify/prettier-config": "^12.0.0",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^4.2.5",
    "homebridge": "^2.1.0",
    "husky": "^7.0.4",
    "nodemon": "^3.1.14",
    "prettier": "^2.8.8",
    "pretty-quick": "^3.1.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "prettier": "@spotify/prettier-config",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "homepage": "https://github.com/cnpittman/homebridge-bluelink-3.0#readme",
  "author": "Andrew Thal",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/athal7"
    },
    {
      "type": "buymeacoffee",
      "url": "https://buymeacoff.ee/athal7"
    }
  ]
}
